{
  "name": "ll-cmaf-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/generate.ts",
    "server": "tsx server/main.ts",
    "dev:client": "vite",
    "dev": "concurrently -k -n server,vite -c blue,green \"npm:server\" \"npm:dev:client\"",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "vitest run && vitest run --config vitest.e2e.config.ts",
    "smoke": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.0.0",
    "playwright": "^1.65.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
